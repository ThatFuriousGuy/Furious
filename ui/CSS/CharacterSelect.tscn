[sub_resource type="Shader" id=1]
code = "shader_type canvas_item;

// Extra height above and below, as a fraction of the texture's height
uniform float extend_top : hint_range(0.0, 5.0) = 0.25;
uniform float extend_bottom : hint_range(0.0, 5.0) = 0.25;
// How many rows at each edge repeat into the extra space
uniform float edge_rows : hint_range(1.0, 128.0, 1.0) = 16.0;

void vertex() {
	float height = 1.0 / TEXTURE_PIXEL_SIZE.y;
	if (UV.y < 0.5) {
		VERTEX.y -= extend_top * height;
		UV.y = -extend_top;
	} else {
		VERTEX.y += extend_bottom * height;
		UV.y = 1.0 + extend_bottom;
	}
}

void fragment() {
	float height = 1.0 / TEXTURE_PIXEL_SIZE.y;
	float y = UV.y * height;
	if (y < 0.0) {
		y = mod(y, edge_rows);
	} else if (y > height) {
		y = height - edge_rows + mod(y - height, edge_rows);
	}
	COLOR = texture(TEXTURE, vec2(UV.x, y / height)) * COLOR;
}"

